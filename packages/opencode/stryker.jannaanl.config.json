{

  "ignorePatterns": [
  "packages/console/app/public/email",
  "sdks/vscode/.vscode-test/**"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "cd packages/opencode && bun test test/explanations/explanations.property.test.ts test/suggestions/suggestions.property.test.ts"
